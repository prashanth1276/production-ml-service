# Application
APP_NAME=Production ML Service
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON=false

# LLM backend:
#   mock               -> deterministic responses, no LLM server required
#   openai_compatible  -> any OpenAI-compatible /v1/chat/completions server
#
# Cloud option (free tier):
#   LLM_BACKEND=openai_compatible
#   LLM_API_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-20b
#   LLM_API_KEY=gsk_your_key_here
LLM_BACKEND=mock
LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# Storage
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# Rate limiting (set to false in tests/CI)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMES=10
RATE_LIMIT_SECONDS=60

# Redis cache (set to false to run without a Redis server)
REDIS_ENABLED=true

# API key authentication
# When enabled, all /api/* endpoints require the X-API-Key header.
API_KEY_ENABLED=false
API_KEY=

# Grafana
GRAFANA_ADMIN_USER=admin

# CORS
CORS_ORIGINS=http://localhost:3000