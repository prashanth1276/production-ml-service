# Application
APP_NAME=Production ML Service
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# LLM backend: "ollama" (real) or "mock" (tests/CI)
LLM_BACKEND=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Storage
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# Rate limiting (set to false in tests/CI)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMES=10
RATE_LIMIT_SECONDS=60

# Redis cache (set to false to run without a Redis server)
REDIS_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:3000